<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional (IIS / runasp.net): sends old links like /work.html to the clean /work/ page. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Old clients page" stopProcessing="true">
          <match url="^clients(\.html)?/?$" />
          <action type="Redirect" url="/brand-family/" redirectType="Permanent" />
        </rule>
        <rule name="Old .html pages" stopProcessing="true">
          <match url="^(about|services|work|contact|careers)\.html$" />
          <action type="Redirect" url="/{R:1}/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
